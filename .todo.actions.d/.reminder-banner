#!/usr/bin/env bash
# Rendered inside the tmux popup by .reminder-notify.
# Reads the task from $TODO_MSG and draws a banner: accent bar, wrapped text.
# No right border on purpose: padding multibyte text to a column is unreliable.

msg="${TODO_MSG:-}"
cols=$(tput cols 2>/dev/null || echo 60)
w=$((cols - 8))
[ "$w" -lt 20 ] && w=20

b=$'\e[1m' d=$'\e[2m' r=$'\e[0m' y=$'\e[1;33m' c=$'\e[36m'
rule=$(printf '%*s' "$w" '' | sed 's/ /─/g')

printf '\n  %s%s%s\n' "$y" "$rule" "$r"
printf '  %s▌%s %s⏰  TODO DUE%s\n' "$y" "$r" "$y" "$r"
printf '  %s▌%s\n' "$y" "$r"
printf '%s' "$msg" | fold -s -w "$((w - 3))" | while IFS= read -r line || [ -n "$line" ]; do
  printf '  %s▌%s %s%s%s\n' "$y" "$r" "$b" "$line" "$r"
done
printf '  %s▌%s\n' "$y" "$r"
printf '  %s▌%s %s%s%s\n' "$y" "$r" "$d" "$(date '+%a %F %H:%M')" "$r"
printf '  %s%s%s\n\n' "$y" "$rule" "$r"
printf '  %spress any key to dismiss%s' "$c" "$r"
read -rsn1
