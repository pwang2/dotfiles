#!/usr/bin/env bash
# todo.sh add-on action: work
#
# For each given task NR, if the task is tagged ado:<id>, sets that
# Azure Boards work item's state to "In Progress". Tasks without an
# ado:<id> tag are skipped (not an error). Does not touch todo.txt.
#
# Install: place this file (executable) in $TODO_ACTIONS_DIR
# (default ~/.todo.actions.d), and symlink `w` -> `work`.
#   ln -s work "$TODO_ACTIONS_DIR/w"
#
# Run with: todo.sh work NR [NR ...]   (or: todo.sh w NR [NR ...])

set -euo pipefail

# todo.sh only exports TODOTXT_CFG_FILE when it was set via -d or the
# environment; its default is resolved after the export block. Re-resolve
# it here so TODO_FILE is populated even if the calling todo.sh didn't
# export it.
TODOTXT_CFG_FILE="${TODOTXT_CFG_FILE:-}"
if [ ! -r "$TODOTXT_CFG_FILE" ]; then
  for cfg in "$HOME/.todo/config" "$HOME/todo.cfg" "$HOME/.todo.cfg" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/todo/config"; do
    if [ -r "$cfg" ]; then
      TODOTXT_CFG_FILE="$cfg"
      break
    fi
  done
fi

if [ -r "$TODOTXT_CFG_FILE" ]; then
  # shellcheck source=/dev/null
  source "$TODOTXT_CFG_FILE"
fi

TAG_PREFIX="ado" # tasks get tagged ado:<id>
WIP_STATE="Committed"

usage() {
  echo "    $TODO_SH work NR [NR ...]"
  echo "      For each NR tagged '${TAG_PREFIX}:<id>', sets that Azure"
  echo "      Boards work item's state to '$WIP_STATE'. Tasks without"
  echo "      an '${TAG_PREFIX}:' tag are ignored."
}

# todo.sh invokes add-ons as: "$TODO_ACTIONS_DIR/work" "$@" -- i.e. $1 is
# the action name itself ("work" or "w"). Drop it so our own args start
# at $1.
[ $# -gt 0 ] && shift

if [ "${1:-}" = "usage" ]; then
  usage
  exit 0
fi

if [ $# -eq 0 ]; then
  usage >&2
  exit 1
fi

if ! command -v az >/dev/null 2>&1; then
  echo "work: 'az' not found in PATH." >&2
  exit 1
fi

status=0
for nr in "$@"; do
  if [[ ! "$nr" =~ ^[0-9]+$ ]]; then
    echo "work: '$nr' is not a task number, skipped." >&2
    status=1
    continue
  fi

  line=$(sed -n "${nr}p" "$TODO_FILE" 2>/dev/null || true)
  id=$(grep -oE "${TAG_PREFIX}:[0-9]+" <<<"$line" | head -n1 | cut -d: -f2 || true)

  if [ -z "$id" ]; then
    echo "work: task $nr has no ${TAG_PREFIX}: tag, ignored."
    continue
  fi

  if az boards work-item update --detect false --id "$id" --state "$WIP_STATE" >/dev/null; then
    echo "work: ${TAG_PREFIX}:${id} -> Azure Boards state '$WIP_STATE'"
  else
    echo "work: failed to update Azure Boards work item ${id}" >&2
    status=1
  fi
done

exit $status
